generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
  SUPER_ADMIN
  OWNER
  SUPPORT
  FINANCE
  RISK
  VIEWER
}

enum RoomStatus {
  DRAFT
  ACTIVE
  PAUSED
  MAINTENANCE
  CLOSED
  ARCHIVED
}

enum RoundStatus {
  OPEN
  LOCKED
  DRAWING
  SPINNING
  SETTLING
  COMPLETED
  CANCELLED
}

enum WalletAccountType {
  MAIN
  BONUS
  HOUSE
}

enum LedgerTransactionType {
  ADMIN_CREDIT
  ADMIN_DEBIT
  ENTRY_HOLD
  ENTRY_REFUND
  ROUND_PAYOUT
  HOUSE_FEE
  DEPOSIT
  WITHDRAWAL_REQUEST
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_REFUND
  WALLET_TRANSFER
}

enum LedgerEntryDirection {
  CREDIT
  DEBIT
}

enum AdminAuditAction {
  ROOM_CREATED
  ROOM_ACTIVATED
  ROOM_PAUSED
  ROOM_CLOSED
  ROOM_ARCHIVED
  ROOM_CONFIGURED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  ADMIN_CREDIT
  ADMIN_DEBIT
  DEPOSIT_APPROVED
  DEPOSIT_CANCELLED
  DEPOSIT_REJECTED
  WITHDRAWAL_APPROVED
  WITHDRAWAL_REJECTED
  WITHDRAWAL_MARKED_PROCESSING
  WITHDRAWAL_MARKED_PAID
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_MARKED_FAILED
  RISK_EVENT_REVIEWED
  RISK_EVENT_DISMISSED
  RISK_EVENT_ACTIONED
  USER_SUSPENDED
  USER_UNSUSPENDED
  ROUND_STARTED
  ROUND_LOCKED
  ROUND_DRAWN
  ROUND_SETTLED
  ROUND_CANCELLED
}

enum GameMode {
  FLEXIBLE_PROPORTIONAL
  FIXED_EQUAL_CHANCE
}

enum PaymentProvider {
  MANUAL
  MOCK
  TELEBIRR_RECEIPT
  TELEBIRR_OFFICIAL
  MANUAL_BANK
  NOWPAYMENTS
  CHAPA
  STRIPE
  CUSTOM
}

enum DepositStatus {
  PENDING
  VERIFYING
  VERIFIED
  CREDITED
  REJECTED
  NEEDS_MANUAL_REVIEW
  CONFIRMED
  FAILED
  EXPIRED
  CANCELLED
}

enum VerificationAttemptStatus {
  ACCEPTED
  REJECTED
  NEEDS_MANUAL_REVIEW
  FETCH_FAILED
  PARSE_FAILED
}

enum WithdrawalStatus {
  PENDING_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  PAID
  REJECTED
  FAILED
  CANCELLED
}

enum RiskEventType {
  IDEMPOTENCY_MISMATCH
  ENTRY_RATE_LIMIT_HIT
  INSUFFICIENT_BALANCE_SPAM
  DUPLICATE_IP_DEVICE
  DUPLICATE_IP_BETTING
  SAME_DEVICE_MULTI_ACCOUNT
  DEPOSIT_WEBHOOK_MISMATCH
  DUPLICATE_PAYMENT_RECEIPT
  MANY_FAILED_RECEIPTS
  WITHDRAWAL_AMOUNT_SPIKE
  FAST_DEPOSIT_WITHDRAWAL
  SUSPICIOUS_WITHDRAWAL
  WITHDRAWAL_AFTER_NEW_DEPOSIT
  ABNORMAL_WIN_PATTERN
  REPEATED_WINNER_ANOMALY
  MULTI_ACCOUNT_PATTERN
  ADMIN_ROUND_INTERVENTION
  PAYMENT_FAILURE_PATTERN
  MANUAL_FLAG
}

enum RiskEventSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskEventStatus {
  OPEN
  REVIEWED
  DISMISSED
  ACTIONED
  RESOLVED
}

enum WorkerJobStatus {
  QUEUED
  ACTIVE
  COMPLETED
  RETRYING
  FAILED
  DEAD_LETTER
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  username        String    @unique
  displayUsername String?
  fullName        String
  phoneNumber     String    @unique
  emailVerified   Boolean   @default(false)
  role            Role      @default(PLAYER)
  image           String?
  bannedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  walletAccounts      WalletAccount[]
  entries             Entry[]
  deposits            Deposit[]
  depositIntents      DepositIntent[]
  withdrawals         Withdrawal[]    @relation("WithdrawalUser")
  reviewedWithdrawals Withdrawal[]    @relation("WithdrawalReviewedByAdmin")
  riskEvents          RiskEvent[]     @relation("RiskEventUser")
  reviewedRiskEvents  RiskEvent[]     @relation("RiskEventReviewedByAdmin")
  riskSignals         RiskSignal[]    @relation("RiskSignalUser")
  sessions            Session[]
  accounts            Account[]
  createdRooms        Room[]          @relation("RoomCreatedByAdmin")
  adminAuditLogs      AdminAuditLog[] @relation("AdminAuditActor")

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

model Category {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  minEntryAmount  BigInt
  maxEntryAmount  BigInt
  maxPlayers      Int      @default(30)
  roundDurationMs Int      @default(45000)
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rooms Room[]

  @@index([isActive, sortOrder])
  @@map("categories")
}

model Room {
  id               String     @id @default(cuid())
  categoryId       String
  code             String
  name             String?
  status           RoomStatus @default(DRAFT)
  gameMode         GameMode   @default(FLEXIBLE_PROPORTIONAL)
  fixedEntryAmount BigInt?
  isPermanent      Boolean    @default(false)
  maxPlayers       Int        @default(30)
  roundDurationMs  Int        @default(45000)
  createdByAdminId String?
  activatedAt      DateTime?
  pausedAt         DateTime?
  closedAt         DateTime?
  archivedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  category       Category @relation(fields: [categoryId], references: [id])
  createdByAdmin User?    @relation("RoomCreatedByAdmin", fields: [createdByAdminId], references: [id])
  rounds         Round[]

  @@unique([categoryId, code])
  @@index([categoryId, status])
  @@index([gameMode])
  @@index([status])
  @@index([isPermanent])
  @@map("rooms")
}

model Round {
  id          String      @id @default(cuid())
  roomId      String
  roundNumber Int
  status      RoundStatus @default(OPEN)

  openedAt    DateTime  @default(now())
  locksAt     DateTime?
  lockedAt    DateTime?
  drawingAt   DateTime?
  spinningAt  DateTime?
  settlingAt  DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  totalEntryAmount BigInt @default(0)
  houseFeeAmount   BigInt @default(0)
  payoutAmount     BigInt @default(0)
  platformFeeBps   Int?

  serverSeedHash    String?
  serverSeedReveal  String?
  fairnessAlgorithm String?
  entriesHash       String?
  drawHash          String?
  drawNonce         Int?
  winningTicket     BigInt?
  winnerUserId      String?
  winnerEntryId     String?
  spinAngle         Float?

  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room    Room    @relation(fields: [roomId], references: [id])
  entries Entry[]

  @@unique([roomId, roundNumber])
  @@index([roomId, status, roundNumber])
  @@index([roomId, status, roundNumber, completedAt])
  @@index([status])
  @@map("rounds")
}

model Entry {
  id          String   @id @default(cuid())
  roundId     String
  userId      String
  amount      BigInt
  ticketStart BigInt?
  ticketEnd   BigInt?
  isWinner    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  round Round @relation(fields: [roundId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([roundId, userId])
  @@index([userId, createdAt])
  @@index([roundId, createdAt, id])
  @@map("entries")
}

model WalletAccount {
  id              String            @id @default(cuid())
  userId          String?
  type            WalletAccountType
  balanceSnapshot BigInt            @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user          User?         @relation(fields: [userId], references: [id])
  ledgerEntries LedgerEntry[]
  withdrawals   Withdrawal[]

  @@unique([userId, type])
  @@index([type])
  @@map("wallet_accounts")
}

model LedgerTransaction {
  id             String                @id @default(cuid())
  type           LedgerTransactionType
  referenceType  String?
  referenceId    String?
  idempotencyKey String                @unique
  metadata       Json?
  createdAt      DateTime              @default(now())

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([type, createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                   String               @id @default(cuid())
  transactionId        String
  walletAccountId      String
  direction            LedgerEntryDirection
  amount               BigInt
  balanceAfterSnapshot BigInt?
  createdAt            DateTime             @default(now())

  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id])
  walletAccount WalletAccount     @relation(fields: [walletAccountId], references: [id])

  @@index([walletAccountId, createdAt])
  @@index([transactionId])
  @@map("ledger_entries")
}

model Deposit {
  id                String          @id @default(cuid())
  userId            String
  provider          PaymentProvider
  providerReference String?
  amount            BigInt
  currency          String          @default("COIN")
  status            DepositStatus   @default(PENDING)
  idempotencyKey    String          @unique
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  confirmedAt       DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerReference])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([provider, status, createdAt])
  @@map("deposits")
}

model DepositIntent {
  id                    String          @id @default(cuid())
  userId                String
  provider              PaymentProvider
  status                DepositStatus   @default(PENDING)
  expectedAmount        Decimal         @db.Decimal(18, 2)
  currency              String          @default("ETB")
  receiverName          String?
  receiverAccount       String?
  receiverShortCode     String?
  providerRef           String?         @unique
  receiptNo             String?         @unique
  creditedWalletEntryId String?
  idempotencyKey        String?         @unique
  rejectionReason       String?
  reviewReason          String?
  rawProviderHash       String?
  verifiedAt            DateTime?
  creditedAt            DateTime?
  expiresAt             DateTime
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user     User                         @relation(fields: [userId], references: [id])
  attempts PaymentVerificationAttempt[]

  @@index([userId, status])
  @@index([provider, status])
  @@index([createdAt])
  @@map("deposit_intents")
}

model PaymentVerificationAttempt {
  id              String                    @id @default(cuid())
  depositIntentId String
  provider        PaymentProvider
  submittedValue  String
  normalizedRef   String?
  status          VerificationAttemptStatus
  reason          String?
  httpStatus      Int?
  providerStatus  String?
  parsedAmount    Decimal?                  @db.Decimal(18, 2)
  parsedCurrency  String?
  parsedReceiver  String?
  parsedPayer     String?
  parsedPaidAt    DateTime?
  rawProviderHash String?
  createdAt       DateTime                  @default(now())

  depositIntent DepositIntent @relation(fields: [depositIntentId], references: [id])

  @@index([depositIntentId])
  @@index([normalizedRef])
  @@index([createdAt])
  @@map("payment_verification_attempts")
}

model Withdrawal {
  id                String           @id @default(cuid())
  userId            String
  walletAccountId   String
  provider          PaymentProvider
  amount            BigInt
  currency          String           @default("COIN")
  destination       Json
  status            WithdrawalStatus @default(PENDING_REVIEW)
  providerReference String?
  requestedAt       DateTime         @default(now())
  reviewedAt        DateTime?
  reviewedByAdminId String?
  paidAt            DateTime?
  rejectionReason   String?
  idempotencyKey    String           @unique
  metadata          Json?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  user            User          @relation("WithdrawalUser", fields: [userId], references: [id])
  walletAccount   WalletAccount @relation(fields: [walletAccountId], references: [id])
  reviewedByAdmin User?         @relation("WithdrawalReviewedByAdmin", fields: [reviewedByAdminId], references: [id])

  @@index([userId, requestedAt])
  @@index([walletAccountId, requestedAt])
  @@index([status, requestedAt])
  @@index([provider, status, requestedAt])
  @@map("withdrawals")
}

model RiskEvent {
  id                String            @id @default(cuid())
  userId            String?
  roomId            String?
  roundId           String?
  type              RiskEventType
  severity          RiskEventSeverity
  status            RiskEventStatus   @default(OPEN)
  score             Int               @default(0)
  summary           String            @default("Risk event requires review.")
  reason            String?
  relatedType       String?
  relatedId         String?
  ipHash            String?
  userAgentHash     String?
  deviceHash        String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  reviewedByAdminId String?
  reviewedAt        DateTime?
  reviewNote        String?
  dismissedAt       DateTime?
  dismissedBy       String?

  user            User? @relation("RiskEventUser", fields: [userId], references: [id])
  reviewedByAdmin User? @relation("RiskEventReviewedByAdmin", fields: [reviewedByAdminId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([roomId, createdAt])
  @@index([roundId, createdAt])
  @@index([type, createdAt])
  @@index([type, status])
  @@index([severity, status])
  @@index([severity, status, createdAt])
  @@index([relatedType, relatedId])
  @@index([ipHash, createdAt])
  @@index([deviceHash, createdAt])
  @@index([createdAt])
  @@map("risk_events")
}

model RiskSignal {
  id            String   @id @default(cuid())
  userId        String?
  type          String
  action        String
  roomId        String?
  roundId       String?
  relatedType   String?
  relatedId     String?
  ipHash        String?
  userAgentHash String?
  deviceHash    String?
  metadata      Json?
  createdAt     DateTime @default(now())

  user User? @relation("RiskSignalUser", fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([roomId, roundId])
  @@index([relatedType, relatedId])
  @@index([ipHash, roundId, createdAt])
  @@index([deviceHash, roundId, createdAt])
  @@index([createdAt])
  @@map("risk_signals")
}

model WorkerJobLog {
  id          String          @id @default(cuid())
  queue       String
  jobId       String
  name        String
  status      WorkerJobStatus @default(QUEUED)
  attempts    Int             @default(0)
  maxAttempts Int             @default(1)
  error       String?
  metadata    Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  completedAt DateTime?
  failedAt    DateTime?

  @@unique([queue, jobId])
  @@index([queue, status, createdAt])
  @@index([status, createdAt])
  @@map("worker_job_logs")
}

model AdminAuditLog {
  id         String           @id @default(cuid())
  actorId    String?
  action     AdminAuditAction
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  metadata   Json?
  createdAt  DateTime         @default(now())

  actor User? @relation("AdminAuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
  @@index([action, createdAt])
  @@map("admin_audit_logs")
}
