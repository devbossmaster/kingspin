{
  "name": "kingspin",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start:api": "pnpm --filter api start:prod",
    "start:web": "pnpm --filter web start",
    "db:generate": "pnpm --filter @kingspin/db db:generate",
    "migrate:deploy": "pnpm --filter @kingspin/db migrate:deploy",
    "migrate:status": "pnpm --filter @kingspin/db migrate:status",
    "db:diagnose-env": "node scripts/diagnose-db-env.mjs",
    "env:diagnose": "node scripts/diagnose-env.mjs",
    "smoke:staging": "node scripts/smoke-check.mjs",
    "security:static": "node scripts/security-static-check.mjs",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "turbo": "^2.9.14",
    "typescript": "5.9.2",
    "vitest": "^4.1.7"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
